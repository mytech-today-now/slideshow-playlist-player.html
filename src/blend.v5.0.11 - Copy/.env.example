# This file contains placeholders only. The static browser app does not load .env files.
# The optional Node server reads its provider values from the process environment.
# Supply both values through BLEND_RUNTIME_CONFIG before app.js runs, or through the
# operator-managed LocalStorage object at blend-runtime-config-v1.
# The anon key is public browser configuration for the selected project. Never use a service-role key.
#
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_STORAGE_BUCKET=
# SUPABASE_CDN_BASE_URL=
# SUPABASE_AUTH_REDIRECT_URL=
# SIGNED_URL_TTL_SECONDS=3600
# MEDIA_METADATA_SOURCE=browser

# Optional official playlist provider API server settings.
# Keep every provider secret in the server environment, never in browser config.
# BLEND_PLAYLIST_SESSION_SECRET=replace-with-at-least-32-random-bytes
# BLEND_BASE_PATH=/tools/m/v/separation
# BLEND_PLAYLIST_ALLOWED_ORIGINS=https://mytech.today
# BLEND_PLAYLIST_TRUST_PROXY=1
# APPLE_MUSIC_ISSUER_ID=
# APPLE_MUSIC_KEY_ID=
# APPLE_MUSIC_PRIVATE_KEY_PEM=
# VIMEO_CLIENT_ID=
# VIMEO_CLIENT_SECRET=
# SOUNDCLOUD_CLIENT_ID=
# SOUNDCLOUD_CLIENT_SECRET=
# DAILYMOTION_CLIENT_ID=
# DAILYMOTION_CLIENT_SECRET=

# Optional cross-browser profile synchronization API settings.
# The Render Blueprint creates a dedicated web service and private Postgres database.
# Keep the GitHub token, token pepper, and admin key hash in Render-managed secrets.
# BLEND_PROFILE_SYNC_ALLOWED_ORIGINS=https://mytech.today
# BLEND_PROFILE_SYNC_FRONTEND_ORIGIN=https://mytech.today
# BLEND_PROFILE_SYNC_FRONTEND_URL=https://mytech.today/index.html
# BLEND_PROFILE_SYNC_COOKIE_SAME_SITE=Strict
# BLEND_PROFILE_SYNC_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
# BLEND_PROFILE_SYNC_GITHUB_TOKEN=
# BLEND_PROFILE_SYNC_GITHUB_BRANCH=main
# BLEND_PROFILE_SYNC_ADMIN_KEY_SHA256=
# BLEND_PROFILE_SYNC_TRUST_PROXY=1
