# This is a placeholder reference only. The static browser app does not load .env files.
# Supply both values through BLEND_RUNTIME_CONFIG before app.js runs, or through the
# operator-managed LocalStorage object at blend-runtime-config-v1.
# The anon key is public browser configuration for the selected project. Never use a service-role key.
#
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_STORAGE_BUCKET=
# SUPABASE_CDN_BASE_URL=
# SUPABASE_AUTH_REDIRECT_URL=
# SIGNED_URL_TTL_SECONDS=3600
# MEDIA_METADATA_SOURCE=browser
